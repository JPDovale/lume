{
  "name": "lume",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-electron.mjs && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && node scripts/dev-electron.mjs\"",
    "build": "npm run icons && tsc -b && vite build && node scripts/build-electron.mjs",
    "lint": "oxlint src electron tests scripts",
    "preview": "vite preview",
    "start": "electron .",
    "test": "vitest run",
    "package": "npm run build && electron-builder --linux dir",
    "test:e2e": "npm run build && node scripts/smoke.mjs && node scripts/recurrence-smoke.mjs",
    "format": "prettier --write src electron tests scripts",
    "icons": "node scripts/build-icons.mjs",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sql.js": "^1.14.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  },
  "main": "dist-electron/main.cjs",
  "description": "Finanças pessoais com clareza",
  "author": "Lume",
  "build": {
    "appId": "local.lume.budget",
    "productName": "Lume",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/sql.js/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "artifactName": "Lume-linux-x86_64.AppImage",
      "desktop": {
        "entry": {
          "StartupWMClass": "lume",
          "Comment": "Finanças pessoais com clareza"
        }
      },
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Lume-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "JPDovale",
      "repo": "lume"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JPDovale/lume.git"
  },
  "homepage": "https://github.com/JPDovale/lume",
  "desktopName": "lume.desktop"
}
